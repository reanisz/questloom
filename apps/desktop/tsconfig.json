{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * `src` には `*.test.ts(x)` と `test-utils.tsx` も入る。除外していないのは、
   * `npm run build` の tsc にテストまで型検査させたいから(vitest は型を見ない)。
   * バンドルには入らない(エントリから辿られないため)。
   */
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
